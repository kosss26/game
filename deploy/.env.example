# ===== Сервер =====
# Домен, направленный A-записью на IP сервера (HTTPS выпустится автоматически)
DOMAIN=stories.example.com
APP_URL=https://stories.example.com

# Пароль базы данных (придумайте длинный: openssl rand -hex 24)
POSTGRES_PASSWORD=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=polnoch_bot
# Короткое имя Mini App из BotFather (/newapp)
APP_SHORT_NAME=app
# openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# ===== Безопасность =====
# openssl rand -hex 32
SESSION_SECRET=
ADMIN_PASSWORD=
# Ваш Telegram ID (узнать у @userinfobot) — вход в студию прямо из приложения
ADMIN_TELEGRAM_IDS=
# openssl rand -hex 24
CRON_SECRET=

# ===== Монетизация и геймплей =====
PRICE_SKIP_DAY_STARS=15
PRICE_SEASON_PASS_STARS=99
REFERRAL_BONUS_SKIPS=1
DEFAULT_WAIT_HOURS=12
ALLOW_WEB_GUESTS=false
