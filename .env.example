# Для своего сервера через Docker см. deploy/.env.example — там всё уже собрано.

# --- База данных: выберите ОДИН вариант ---
# 1) Свой PostgreSQL (рекомендуется)
DATABASE_URL=postgresql://user:password@localhost:5432/polnoch
# DATABASE_SSL=true
# 2) Supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# 3) Ничего не задано — локальная демо-база .data/local-db.json (только разработка)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=polnoch_bot
# Короткое имя Mini App из BotFather (/newapp) — для ссылок-приглашений t.me/<bot>/<app>
APP_SHORT_NAME=app
APP_URL=https://your-domain.com
# 16–256 символов A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# --- Безопасность ---
# Подпись сессий (не короче 16 символов). Если не задан — выводится из токена бота.
SESSION_SECRET=
# Пароль входа в /admin из браузера
ADMIN_PASSWORD=
# Telegram ID админов через запятую (вход в студию прямо из Mini App)
ADMIN_TELEGRAM_IDS=
# Секрет для /api/cron/notify (Authorization: Bearer ...)
CRON_SECRET=

# --- Монетизация и геймплей ---
PRICE_SKIP_DAY_STARS=15
PRICE_SEASON_PASS_STARS=99
REFERRAL_BONUS_SKIPS=1
# Ожидание между днями по умолчанию (часы), если в скрипте нет @wait
DEFAULT_WAIT_HOURS=12
# Разрешить игру в обычном браузере (гостевой аккаунт). В dev включено всегда.
ALLOW_WEB_GUESTS=false
# Только для стендов/QA: принудительное ожидание между днями (например 0)
# FORCE_WAIT_HOURS=0
